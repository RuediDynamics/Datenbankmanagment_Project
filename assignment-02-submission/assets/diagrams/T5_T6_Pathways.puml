@startuml T5_T6_Ranking_TieBreak_Pathways
!theme plain
skinparam backgroundColor #FAFAFA
skinparam arrowColor #333333
skinparam classBackgroundColor #E8F4F8
skinparam classBorderColor #0066CC

title T5 & T6: Display Rankings and Resolve Tie-Breaks

package "T5: Display Day Scores and Leaderboard" {
    rectangle "1. SELECT CompetitionCategory\n(style, division, classLevel)" as T5_1 #E6F3FF
    rectangle "2. GET all Registrations\nin this category" as T5_2 #FFE6E6
    rectangle "3. FOR each Registration:" as T5_3 #FFF9E6
    rectangle "3a. LOOKUP Participant\n(firstName, lastName)" as T5_3a #E6F3FF
    rectangle "3b. GET Nation\n(nationCode)" as T5_3b #E6F3FF
    rectangle "3c. AGGREGATE ScoreCards\nbyRound (R1, R2, R3, R4)" as T5_3c #FFE6E6
    rectangle "3d. COMPUTE roundTotal\n(SUM of ShotResults)" as T5_3d #FFE6E6
    rectangle "4. LOOKUP TournamentResult\n(totalPoints✅DERIVED,\nrankPosition✅DERIVED)" as T5_4 #E6F3FF
    rectangle "5. RANK participants\nORDER BY totalPoints DESC" as T5_5 #FFE6E6
    rectangle "6. DISPLAY leaderboard\nfor category" as T5_6 #FFE6E6
}

package "T6: Record Tie-Break and Determine Winner" {
    rectangle "1. IDENTIFY tied participants\n(same totalPoints in category)" as T6_1 #FFE6E6
    rectangle "2. SELECT TargetGroup\n(1..4 for shoot-off)" as T6_2 #E6F3FF
    rectangle "3. CREATE TieBreak record\n(tieBreakId, tieBreakRound)" as T6_3 #FFE6E6
    rectangle "4. FOR each tied participant:" as T6_4 #FFF9E6
    rectangle "4a. Record 3 shots\nat target (arrows 1-3)" as T6_4a #FFE6E6
    rectangle "4b. INSERT ShotResults\n(tied to TieBreak)" as T6_4b #FFE6E6
    rectangle "4c. COMPUTE tie-break total\n(SUM of 3 shots)" as T6_4c #FFE6E6
    rectangle "5. DETERMINE winner\n(highest 3-shot total)" as T6_5 #FFE6E6
    rectangle "6. UPDATE TournamentResult\nSET rankPosition = final_rank\nSET tieBreakStatus = 'Resolved'" as T6_6 #FFE6E6
}

T5_1 --> T5_2 : categorisedAs\n(*..1)
T5_2 --> T5_3 : FOR each Reg
T5_3 --> T5_3a : submits\n(reverse)
T5_3 --> T5_3b : representsNation
T5_3 --> T5_3c : recordsFor\n(ScoreCards)
T5_3c --> T5_3d : contains\n(ShotResults)\nSUM points
T5_3d --> T5_4 : summarises\n(1..1)
T5_4 --> T5_5 : RANK\nderivation
T5_5 --> T5_6 : DISPLAY

T5_1 -.-> T6_1 : LATER:\ncheck ties
T6_1 --> T6_2 : SELECT from\nTargetStation\n(targetGroup)
T6_2 --> T6_3 : CREATE\nfor resolution
T6_3 --> T6_4 : FOR each\ntied participant
T6_4 --> T6_4a : RECORD\n3 arrows
T6_4a --> T6_4b : uses\n(TieBreak→ShotResult)
T6_4b --> T6_4c : SUM\n3 shots
T6_4c --> T6_5 : COMPARE\ntotals
T6_5 --> T6_6 : resolvesTie\nUPDATE ranks


@enduml
